{
  // Cloudflare Workers static-assets config. Workers Builds runs `bun run build`
  // then `npx wrangler deploy`, which uploads dist/ — there is no Worker script.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blissful-living-solutions",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./dist",
    // /privacy-policy.html → /privacy-policy (canonical URLs already use the clean form)
    "html_handling": "auto-trailing-slash"
  }
}
