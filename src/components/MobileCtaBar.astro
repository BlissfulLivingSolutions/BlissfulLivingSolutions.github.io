---
/**
 * Phones only: a quiet way back to the consultation form. main.js
 * (initMobileCtaBar) shows it once the hero has scrolled away and hides it from
 * #contact onward; CSS hides it at ≥768px and in print.
 */
---
<div class="mobile-cta-bar" id="mobile-cta-bar">
    <a href="#contact" class="btn btn-primary btn-lg" data-cta-label="mobile_sticky_consultation" data-cta-section="sticky-bar">Request a free consultation</a>
</div>
