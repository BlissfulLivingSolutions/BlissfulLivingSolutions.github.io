---
/**
 * Care Planning Worksheet (#service-plan-section).
 *
 * On screen only the `.worksheet.screen-only` callout shows. The `.print-only`
 * header, the twelve-section `.spt-body` (A–L) and the footer are what
 * window.print() puts on paper — styled by the `.spt-*` rules inside
 * `@media print` in src/styles/base.css.
 *
 * This markup was moved here byte-for-byte from the pre-Astro index.html.
 * Edit it surgically; never retype it.
 */
---
<div class="feature-block" id="service-plan-section">

    <!-- Print-only: document header -->
    <div class="print-only print-doc-header" aria-hidden="true">
        <div class="print-brand-bar">
            <span class="print-brand-name">Blissful Living Solutions LLC</span>
            <span class="print-brand-sub">Compassionate Non-Medical Home Care &nbsp;·&nbsp; Lemont, IL 60439</span>
        </div>
        <div class="print-doc-title">
            <h1>Care Planning Worksheet</h1>
            <p>Complete this worksheet before your first consultation to help organize the care details that matter most. Questions? Email contact@blissfullivingsolutions.com</p>
        </div>
    </div>

    <!-- Screen-only: worksheet callout -->
    <div class="worksheet screen-only">
        <div class="worksheet-art" aria-hidden="true">
            <div class="sheet sheet--back"></div>
            <div class="sheet sheet--front">
                <span class="sheet-bar"></span>
                <span class="sheet-title"></span>
                <span class="sheet-label"></span>
                <span class="sheet-line"></span>
                <span class="sheet-line"></span>
                <span class="sheet-label"></span>
                <span class="sheet-line"></span>
                <span class="sheet-checks"><span></span><span></span><span></span></span>
                <span class="sheet-label"></span>
                <span class="sheet-line"></span>
                <span class="sheet-line"></span>
            </div>
        </div>
        <div class="worksheet-copy">
            <h2>Ready to plan together?</h2>
            <p>We begin every care arrangement with a personal discussion about your loved one's daily routines, preferences, and what matters most to your family. Our Care Planning Worksheet helps you organize those details in advance — so our first call can focus on what really counts.</p>
            <button class="btn btn-primary" type="button" onclick="window.print()">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                </svg>
                Print the care planning worksheet
            </button>
            <p class="worksheet-meta">Twelve short sections covering care goals, emergency contacts, and a preferred schedule. Fill it in by hand, at your own pace.</p>
        </div>
    </div>

    <!-- Print-only: full service plan template body -->
    <div class="print-only spt-body" aria-hidden="true">

        <!-- A. Client Information -->
        <div class="spt-section">
            <h2 class="spt-section-title">Client Information</h2>
            <div class="spt-grid-2">
                <div class="spt-field">
                    <span class="spt-label">Client Name</span>
                    <div class="spt-line"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Date of Birth</span>
                    <div class="spt-line"></div>
                </div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Home Address</span>
                <div class="spt-line"></div>
            </div>
            <div class="spt-grid-2">
                <div class="spt-field">
                    <span class="spt-label">Phone Number</span>
                    <div class="spt-line"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Alternate Phone</span>
                    <div class="spt-line"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Email Address (if applicable)</span>
                    <div class="spt-line"></div>
                </div>
            </div>
        </div>

        <!-- B. Emergency Contacts -->
        <div class="spt-section">
            <h2 class="spt-section-title">Emergency Contacts</h2>
            <div class="spt-grid-2">
                <div class="spt-contact-block">
                    <p class="spt-sub-label">Contact 1</p>
                    <div class="spt-field">
                        <span class="spt-label">Name</span>
                        <div class="spt-line"></div>
                    </div>
                    <div class="spt-field">
                        <span class="spt-label">Relationship</span>
                        <div class="spt-line"></div>
                    </div>
                    <div class="spt-field">
                        <span class="spt-label">Phone Number</span>
                        <div class="spt-line"></div>
                    </div>
                    <div class="spt-field">
                        <span class="spt-label">Alternate Phone</span>
                        <div class="spt-line"></div>
                    </div>
                </div>
                <div class="spt-contact-block">
                    <p class="spt-sub-label">Contact 2</p>
                    <div class="spt-field">
                        <span class="spt-label">Name</span>
                        <div class="spt-line"></div>
                    </div>
                    <div class="spt-field">
                        <span class="spt-label">Relationship</span>
                        <div class="spt-line"></div>
                    </div>
                    <div class="spt-field">
                        <span class="spt-label">Phone Number</span>
                        <div class="spt-line"></div>
                    </div>
                    <div class="spt-field">
                        <span class="spt-label">Alternate Phone</span>
                        <div class="spt-line"></div>
                    </div>
                </div>
            </div>
            <p class="spt-note">Add additional emergency contacts on a separate sheet if needed.</p>
        </div>

        <!-- C. Authorized Representative -->
        <div class="spt-section">
            <h2 class="spt-section-title">Authorized Representative <span class="spt-optional">(if applicable)</span></h2>
            <div class="spt-grid-2">
                <div class="spt-field">
                    <span class="spt-label">Name</span>
                    <div class="spt-line"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Relationship / Role</span>
                    <div class="spt-line"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Phone Number</span>
                    <div class="spt-line"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Email</span>
                    <div class="spt-line"></div>
                </div>
            </div>
            <p class="spt-note">e.g., legal guardian, power of attorney, or other person authorized to make care decisions.</p>
        </div>

        <!-- D. Care Needs & Goals -->
        <div class="spt-section">
            <h2 class="spt-section-title">Care Needs &amp; Goals</h2>
            <div class="spt-field">
                <span class="spt-label">Summary of Care Needs</span>
                <p class="spt-hint">Describe the client's current situation, daily challenges, and what prompted the need for home care.</p>
                <div class="spt-line-tall"></div>
            </div>
            <div class="spt-field spt-field--spaced">
                <span class="spt-label">Client Goals</span>
                <p class="spt-hint">What does the client hope to maintain or achieve through home care?</p>
                <div class="spt-line-tall"></div>
            </div>
        </div>

        <!-- E. Services Requested -->
        <div class="spt-section">
            <h2 class="spt-section-title">Services Requested</h2>
            <p class="spt-hint">Check all that apply.</p>
            <div class="spt-checkbox-group">
                <div class="spt-check-row">
                    <input type="checkbox">
                    <span class="spt-check-text"><strong>Personal Care</strong> — bathing, dressing, toileting, mobility assistance, and eating</span>
                </div>
                <div class="spt-check-row">
                    <input type="checkbox">
                    <span class="spt-check-text"><strong>Homemaker Services</strong> — light housekeeping, laundry, meal preparation, and errands</span>
                </div>
                <div class="spt-check-row">
                    <input type="checkbox">
                    <span class="spt-check-text"><strong>Companionship</strong> — supervision, social activities, and accompaniment on outings</span>
                </div>
                <div class="spt-check-row">
                    <input type="checkbox">
                    <span class="spt-check-text"><strong>Other:</strong> &nbsp;<span class="spt-inline-line spt-inline-line--long"></span></span>
                </div>
            </div>
        </div>

        <!-- F. Specific Caregiver Tasks -->
        <div class="spt-section">
            <h2 class="spt-section-title">Specific Caregiver Tasks</h2>
            <p class="spt-hint">Check each task the caregiver should perform and note how often. All tasks are non-medical.</p>
            <div class="spt-task-grid">
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Bathing / showering assistance</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Grooming &amp; personal hygiene</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Dressing assistance</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Toileting &amp; incontinence care</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Mobility &amp; transfer support</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Medication reminders (non-medical only)</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                        <div class="spt-task-freq">Time(s) of Day:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Meal preparation &amp; feeding assistance</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Light housekeeping &amp; laundry</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Pet care (feeding, letting out)</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Grocery shopping &amp; errands</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Transportation to appointments</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
                <div class="spt-task-item">
                    <input type="checkbox">
                    <div class="spt-task-detail">
                        <span class="spt-check-text">Companionship activities</span>
                        <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                    </div>
                </div>
            </div>
            <div class="spt-task-item spt-task-other">
                <input type="checkbox">
                <div class="spt-task-detail">
                    <span class="spt-check-text">Other:&nbsp;<span class="spt-inline-line spt-inline-line--long"></span></span>
                    <div class="spt-task-freq">Frequency:&nbsp;<span class="spt-inline-line"></span></div>
                </div>
            </div>
        </div>

        <!-- G. Preferred Schedule -->
        <div class="spt-section">
            <h2 class="spt-section-title">Preferred Schedule</h2>
            <div class="spt-grid-2">
                <div class="spt-field">
                    <span class="spt-label">Preferred Days</span>
                    <div class="spt-line"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Preferred Time(s)</span>
                    <div class="spt-line"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Approximate Hours Per Visit</span>
                    <div class="spt-line"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Desired Start Date</span>
                    <div class="spt-line"></div>
                </div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Overall Visit Frequency</span>
                <div class="spt-line"></div>
            </div>
            <p class="spt-note">Example: 3 visits per week, Mon / Wed / Fri, 9:00 am – 1:00 pm, approx. 4 hours per visit.</p>
        </div>

        <!-- H. Special Instructions & Precautions -->
        <div class="spt-section">
            <h2 class="spt-section-title">Special Instructions &amp; Precautions</h2>
            <div class="spt-grid-2">
                <div class="spt-field">
                    <span class="spt-label">Allergies (food, medication, etc.)</span>
                    <div class="spt-line-2"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Dietary Needs / Restrictions</span>
                    <div class="spt-line-2"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Activity / Functional Limitations</span>
                    <div class="spt-line-2"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Cognitive / Behavioral Considerations</span>
                    <div class="spt-line-2"></div>
                </div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Client Limitations</span>
                <div class="spt-line-2"></div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Mental Health &amp; Emotional Status</span>
                <div class="spt-line-2"></div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Safety Procedures Essential for This Client</span>
                <div class="spt-line-2"></div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Primary Physician (Name &amp; Practice)</span>
                <div class="spt-line"></div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Current Medications <span class="spt-optional">(for caregiver awareness only)</span></span>
                <div class="spt-line-2"></div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Treatments Being Received <span class="spt-optional">(for caregiver awareness)</span></span>
                <div class="spt-line-2"></div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Other Precautions or Important Information</span>
                <p class="spt-hint">e.g., fall risk, hearing/vision impairment, communication needs</p>
                <div class="spt-line-2"></div>
            </div>
            <p class="spt-note">Caregivers provide non-medical support only and will not perform nursing or clinical tasks.</p>
        </div>

        <!-- I. Home Environment & Safety -->
        <div class="spt-section">
            <h2 class="spt-section-title">Home Environment &amp; Safety</h2>
            <div class="spt-grid-2">
                <div class="spt-field">
                    <span class="spt-label">Home Safety Risks</span>
                    <p class="spt-hint">e.g., loose rugs, poor lighting, stairs</p>
                    <div class="spt-line-2"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Pets in Home</span>
                    <div class="spt-line-2"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Equipment &amp; Assistive Devices</span>
                    <p class="spt-hint">e.g., cane, walker, wheelchair, oxygen</p>
                    <div class="spt-line-2"></div>
                </div>
                <div class="spt-field">
                    <span class="spt-label">Emergency Plan</span>
                    <p class="spt-hint">e.g., medical alert system, 911 instructions</p>
                    <div class="spt-line-2"></div>
                </div>
            </div>
            <div class="spt-field">
                <span class="spt-label">Other Environment Notes</span>
                <div class="spt-line-2"></div>
            </div>
        </div>

        <!-- J. Visit Documentation -->
        <div class="spt-section">
            <h2 class="spt-section-title">Visit Documentation</h2>
            <p class="spt-hint">Select the preferred method for documenting caregiver visits.</p>
            <div class="spt-checkbox-group spt-checkbox-group--inline">
                <div class="spt-check-row">
                    <input type="checkbox">
                    <span class="spt-check-text">Caregiver daily notes / log</span>
                </div>
                <div class="spt-check-row">
                    <input type="checkbox">
                    <span class="spt-check-text">Task checklist &amp; client initials</span>
                </div>
                <div class="spt-check-row">
                    <input type="checkbox">
                    <span class="spt-check-text">Electronic Visit Verification (EVV)</span>
                </div>
                <div class="spt-check-row">
                    <input type="checkbox">
                    <span class="spt-check-text">Other:&nbsp;<span class="spt-inline-line"></span></span>
                </div>
            </div>
            <div class="spt-field spt-field--spaced">
                <span class="spt-label">Record Location</span>
                <p class="spt-hint">Where documentation is kept (e.g., binder in home, electronic portal)</p>
                <div class="spt-line"></div>
            </div>
        </div>

        <!-- K. Plan Review Log -->
        <div class="spt-section">
            <h2 class="spt-section-title">Plan Review Log</h2>
            <p class="spt-hint">Review and update this plan at least annually or when the client's needs change.</p>
            <table class="spt-table">
                <thead>
                    <tr>
                        <th style="width: 18%;">Review Date</th>
                        <th style="width: 28%;">Reviewed By</th>
                        <th>Summary of Changes</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                    <tr>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- L. Signatures -->
        <div class="spt-section spt-signatures">
            <h2 class="spt-section-title">Signatures</h2>
            <p class="spt-hint">By signing below, the client (or representative) and Blissful Living Solutions LLC confirm that this Care Planning Worksheet was reviewed together and reflects the agreed-upon plan for non-medical
                care services.</p>
            <div class="spt-sig-row">
                <div class="spt-sig-block">
                    <div class="spt-sig-line"></div>
                    <p class="spt-sig-caption">Client / Representative Signature</p>
                </div>
                <div class="spt-sig-date">
                    <div class="spt-sig-line"></div>
                    <p class="spt-sig-caption">Date</p>
                </div>
            </div>
            <div class="spt-sig-row">
                <div class="spt-sig-block">
                    <div class="spt-sig-line"></div>
                    <p class="spt-sig-caption">Agency Representative Signature</p>
                </div>
                <div class="spt-sig-date">
                    <div class="spt-sig-line"></div>
                    <p class="spt-sig-caption">Date</p>
                </div>
            </div>
        </div>

    </div><!-- end .spt-body -->

    <!-- Print-only: document footer -->
    <div class="print-only print-doc-footer" aria-hidden="true">
        <p>Non-medical services only. All care plans are personalized to client needs. &nbsp;·&nbsp; contact@blissfullivingsolutions.com &nbsp;·&nbsp; Lemont, IL 60439</p>
    </div>

</div>
