---
import BaseLayout from '../layouts/BaseLayout.astro'

const title = 'Privacy Policy | Blissful Living Solutions'
const description = 'Privacy policy for Blissful Living Solutions LLC — how we handle contact information and optional analytics cookies.'
---
<BaseLayout title={title} description={description}>
    <section class="section">
        <div class="container">
            <div class="prose">

                <h1>Privacy Policy</h1>
                <p class="prose-meta">
                    Blissful Living Solutions LLC &mdash; Last updated April 2026
                </p>

                <p>Blissful Living Solutions LLC (&ldquo;we,&rdquo; &ldquo;us,&rdquo; or &ldquo;our&rdquo;) operates the website at
                    <a href="https://www.blissfullivingsolutions.com">www.blissfullivingsolutions.com</a>.
                    This page explains how we collect and use information when you visit our site.
                    We provide non-medical home care services only and do not offer or solicit medical services through this website.
                </p>

                <h2>Information We Collect</h2>

                <h3>Contact Form</h3>
                <p>When you submit the contact form on our website, you provide us with:</p>
                <ul>
                    <li>Your name</li>
                    <li>Your email address</li>
                    <li>Your phone number</li>
                    <li>A message describing how we can help</li>
                </ul>
                <p>Submitting the form opens your device&rsquo;s default email client and sends your message directly to
                    <a href="mailto:contact@blissfullivingsolutions.com">contact@blissfullivingsolutions.com</a>.
                    We use this information solely to respond to your inquiry. We do not sell, rent, or share it with third parties
                    for marketing purposes.
                </p>

                <h3>Analytics Cookies (Optional)</h3>
                <p>With your consent, we use Google Analytics 4 to collect anonymous usage data such as which pages are visited,
                    how long visitors stay, and general traffic patterns. This helps us understand how people use the site
                    so we can improve it over time.</p>
                <p>Analytics cookies are <strong>optional</strong>. We do not load any analytics scripts or set any analytics
                    cookies until you explicitly click &ldquo;Accept Analytics&rdquo; on the cookie banner shown at your first visit.</p>
                <p>If you decline, no analytics cookies are set and no usage data is sent to Google.</p>

                <h3>What Analytics Does Not Collect</h3>
                <p>Our analytics setup is configured to never receive:</p>
                <ul>
                    <li>Your name, email address, or phone number</li>
                    <li>Any text you type into the contact form</li>
                    <li>Precise location data</li>
                    <li>Any information that could identify you individually</li>
                </ul>
                <p>We do not use analytics data for advertising. Ad-related Google features (ad storage, ad personalization)
                    remain disabled regardless of your cookie choice.</p>

                <h2>Third-Party Services</h2>
                <p>If you accept analytics cookies, data is processed by Google LLC under
                    <a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Google&rsquo;s Privacy Policy</a>.
                    IP anonymization is enabled. We do not share analytics data with any other third party.
                </p>
                <p>The map embedded on our site is served by
                    <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>,
                    which has its own privacy policy.
                </p>

                <h2>Managing Your Cookie Preferences</h2>
                <p>You can change your analytics cookie choice at any time by clicking
                    <strong>&ldquo;Cookie Preferences&rdquo;</strong> in the footer of any page on this site.
                    Choosing &ldquo;Decline&rdquo; will prevent any further analytics data from being sent.
                    Your preference is stored locally in your browser and does not expire automatically.
                </p>
                <p>You can also clear your browser&rsquo;s local storage or cookies at any time to reset your choice.</p>

                <h2>Data Retention</h2>
                <p>Contact messages you send us are retained only as long as necessary to respond to your inquiry and conduct
                    normal business. Anonymous analytics data is retained according to Google Analytics default settings
                    (typically 14 months).</p>

                <h2>Children&rsquo;s Privacy</h2>
                <p>This website is not directed to children under 13. We do not knowingly collect personal information
                    from children.</p>

                <h2>Changes to This Policy</h2>
                <p>We may update this policy as our practices change. The &ldquo;Last updated&rdquo; date at the top of this
                    page reflects the most recent revision.</p>

                <h2>Contact Us</h2>
                <p>If you have questions about this privacy policy or how we handle your information, please email us at
                    <a href="mailto:contact@blissfullivingsolutions.com">contact@blissfullivingsolutions.com</a>.
                </p>

                <div class="prose-back">
                    <a href="/" class="btn btn-outline">&larr; Back to Home</a>
                </div>

            </div>
        </div>
    </section>
</BaseLayout>
